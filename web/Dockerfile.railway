# Railway production Dockerfile for web (static files only)
FROM node:20-alpine AS deps

WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# VITE_API_URL will be set via Railway environment variables
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm build

# Serve static files with nginx (no API proxy)
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Remove default nginx config and create template with PORT placeholder
RUN rm -f /etc/nginx/conf.d/default.conf && \
    mkdir -p /etc/nginx/templates && echo 'server { \
    listen ${PORT}; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml; \
}' > /etc/nginx/templates/default.conf.template

# nginx will substitute $PORT at runtime from environment
CMD ["nginx", "-g", "daemon off;"]

