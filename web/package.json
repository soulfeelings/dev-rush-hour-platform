{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "vite preview",
    "prepare": "if [ \"$SKIP_LEFTHOOK\" = \"1\" ]; then echo \"skip lefthook\"; else lefthook install; fi",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:api": "orval",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --project=ui",
    "test:api": "playwright test --project=api",
    "test:api:smoke": "playwright test --project=api tests/api/smoke.api.spec.ts",
    "test:api:smoke:admin": "playwright test --project=api tests/api/admin/smoke.spec.ts",
    "test:api:regress": "playwright test --project=api tests/api/all_gets.api.spec.ts",
    "test:ui": "playwright test --project=ui tests/ui/*.spec.ts",
    "test:ui:admin": "playwright test --project=ui tests/ui/admin.spec.ts",
    "test:ui:critical": "playwright test --project=ui tests/ui/critical.spec.ts tests/ui/catalog-filters.spec.ts",
    "test:ui:regress": "playwright test --project=ui tests/ui/regression.spec.ts",
    "test:ui:final": "playwright test --project=ui tests/ui/smoke.spec.ts tests/ui/critical.spec.ts tests/ui/catalog-filters.spec.ts tests/ui/regression.spec.ts tests/ui/admin.spec.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.2.0",
    "@azure/msal-react": "^5.0.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.62.11",
    "@turf/turf": "^7.3.1",
    "@types/leaflet.markercluster": "^1.5.6",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.26",
    "i18next": "^25.7.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.561.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.10.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@storybook/test": "^8.2.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.11",
    "globals": "^16.5.0",
    "lefthook": "^2.0.12",
    "orval": "^7.5.0",
    "pg": "^8.17.2",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.96.0",
    "storybook": "^10.1.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
