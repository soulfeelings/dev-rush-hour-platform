# Автоматически определять текстовые файлы и использовать LF
* text=auto eol=lf

# Явно указываем LF для исходного кода
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
